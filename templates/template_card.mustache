{{!
    @template local_mailwhistle/template_card

    One template overview card.

    Context variables required for this template:
    * name - Raw template name (data attribute for Behat).
    * displayname - format_string() name.
    * archived - Whether the template is archived.
    * background - Safe hex background colour.
    * haspreview - Whether preview HTML is present.
    * previewhtml - Sanitised preview HTML from format_text().
    * haspreviewtext - Whether preview text is present.
    * previewtext - format_string() preview text.
    * lastedited - Formatted last-edited date.
    * previewurl - Preview page URL.
    * canmanage - Whether manage actions are shown.
    * editurl, exporturl, deleteurl, actionurl, sesskey, candelete.

    Example context (json):
    {
        "name": "Default",
        "displayname": "Default",
        "archived": false,
        "background": "#ffffff",
        "haspreview": true,
        "previewhtml": "<p>Hi</p>",
        "haspreviewtext": false,
        "previewtext": "",
        "lastedited": "9 Sep 2026",
        "previewurl": "#",
        "canmanage": true,
        "editurl": "#",
        "exporturl": "#",
        "deleteurl": "#",
        "actionurl": "/local/mailwhistle/index.php",
        "sesskey": "abc",
        "candelete": true,
        "id": 1
    }
}}
<div class="local-mailwhistle-template-card" data-template-name="{{name}}">
    <div class="local-mailwhistle-template-preview">
        <div class="local-mailwhistle-template-preview-canvas" style="background: {{background}};">
            {{#haspreview}}{{{previewhtml}}}{{/haspreview}}
            {{^haspreview}}
                <div class="local-mailwhistle-template-preview-empty">{{#str}}template_no_body, local_mailwhistle{{/str}}</div>
            {{/haspreview}}
        </div>
    </div>
    <div class="local-mailwhistle-template-card-body">
        <h4 class="local-mailwhistle-template-title">
            {{{displayname}}}
            {{#archived}}
                <span class="badge bg-secondary">{{#str}}template_archived_badge, local_mailwhistle{{/str}}</span>
            {{/archived}}
        </h4>
        <div class="local-mailwhistle-template-meta-list">
            {{#haspreviewtext}}
                <div class="local-mailwhistle-template-meta local-mailwhistle-template-meta-preview">
                    <span class="local-mailwhistle-template-label">{{#str}}template_previewtext_label, local_mailwhistle{{/str}}</span>
                    <span class="local-mailwhistle-template-value">{{{previewtext}}}</span>
                </div>
            {{/haspreviewtext}}
            <div class="local-mailwhistle-template-meta local-mailwhistle-template-meta-date">
                <span class="local-mailwhistle-template-label">{{#str}}template_lastedited_label, local_mailwhistle{{/str}}</span>
                <span class="local-mailwhistle-template-value">{{lastedited}}</span>
            </div>
        </div>
    </div>
    <div class="local-mailwhistle-template-actions">
        <a href="{{previewurl}}" class="btn btn-primary">{{#str}}template_preview, local_mailwhistle{{/str}}</a>
        {{#canmanage}}
            <div class="dropdown local-mailwhistle-template-actions-menu">
                <button class="btn btn-secondary dropdown-toggle" type="button"
                        data-toggle="dropdown" data-bs-toggle="dropdown"
                        aria-haspopup="true" aria-expanded="false">
                    {{#str}}template_actions, local_mailwhistle{{/str}}
                </button>
                <div class="dropdown-menu dropdown-menu-right">
                    <a href="{{editurl}}" class="dropdown-item">{{#str}}template_edit, local_mailwhistle{{/str}}</a>
                    <a href="{{exporturl}}" class="dropdown-item">{{#str}}template_export, local_mailwhistle{{/str}}</a>
                    {{^archived}}
                        <form method="post" action="{{actionurl}}" class="m-0">
                            <input type="hidden" name="tab" value="templates">
                            <input type="hidden" name="action" value="archive">
                            <input type="hidden" name="id" value="{{id}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <button type="submit" class="dropdown-item">{{#str}}template_archive, local_mailwhistle{{/str}}</button>
                        </form>
                    {{/archived}}
                    {{#archived}}
                        <form method="post" action="{{actionurl}}" class="m-0">
                            <input type="hidden" name="tab" value="templates">
                            <input type="hidden" name="action" value="restore">
                            <input type="hidden" name="id" value="{{id}}">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <button type="submit" class="dropdown-item">{{#str}}template_restore, local_mailwhistle{{/str}}</button>
                        </form>
                    {{/archived}}
                    {{#candelete}}
                        <a href="{{deleteurl}}" class="dropdown-item text-danger">{{#str}}delete{{/str}}</a>
                    {{/candelete}}
                </div>
            </div>
        {{/canmanage}}
    </div>
</div>
