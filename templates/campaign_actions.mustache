{{!
    @template local_mailwhistle/campaign_actions

    Campaign table actions using Moodle icons and accessible labels.

    Context variables required for this template:
    * actionurl, campaignid, sesskey - POST action target and parameters.
    * cansend - Whether the campaign is ready to send.
    * hasschedule, scheduleurl, schedulelabel - Schedule action availability, URL and label.
    * duplicatelabel - Accessible label including the campaign name.

    Example context (json):
    {
        "actionurl": "/local/mailwhistle/index.php",
        "campaignid": 1,
        "sesskey": "abc",
        "cansend": true,
        "hasschedule": true,
        "scheduleurl": "/local/mailwhistle/campaign_schedule.php?campaignid=1",
        "schedulelabel": "Schedule campaign",
        "duplicatelabel": "Duplicate campaign: Newsletter"
    }
}}
<div class="d-flex flex-wrap align-items-center gap-2">
    {{#cansend}}
        <form method="post" action="{{actionurl}}" class="m-0">
            <input type="hidden" name="tab" value="send">
            <input type="hidden" name="action" value="sendnow">
            <input type="hidden" name="campaignid" value="{{campaignid}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-secondary">
                {{#pix}}t/email, core{{/pix}}{{#str}}sendnow, local_mailwhistle{{/str}}
            </button>
        </form>
    {{/cansend}}
    {{#hasschedule}}
        <a href="{{scheduleurl}}" class="btn btn-icon" title="{{schedulelabel}}" aria-label="{{schedulelabel}}">
            {{#pix}}i/calendar, core{{/pix}}
            <span class="accesshide">{{schedulelabel}}</span>
        </a>
    {{/hasschedule}}
    <form method="post" action="{{actionurl}}" class="m-0">
        <input type="hidden" name="tab" value="send">
        <input type="hidden" name="action" value="duplicatecampaign">
        <input type="hidden" name="campaignid" value="{{campaignid}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <button type="submit" class="btn btn-icon" title="{{duplicatelabel}}" aria-label="{{duplicatelabel}}">
            {{#pix}}t/copy, core{{/pix}}
            <span class="accesshide">{{#str}}duplicatecampaign, local_mailwhistle{{/str}}</span>
        </button>
    </form>
</div>
