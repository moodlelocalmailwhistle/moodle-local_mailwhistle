{{!
    @template local_mailwhistle/test_email

    Campaign test-email launcher and accessible results region.

    Context variables required for this template:
    * campaignid - Saved campaign id.

    Example context (json):
    {"campaignid": 42}
}}
<div id="local-mailwhistle-test-email-{{campaignid}}" class="local-mailwhistle-testmail mb-3"
        data-campaignid="{{campaignid}}">
    <button type="button" class="btn btn-secondary" data-action="send-test-email" disabled>
        {{#str}} testmail_title, local_mailwhistle {{/str}}
    </button>
    <noscript><p>{{#str}} testmail_requiresjavascript, local_mailwhistle {{/str}}</p></noscript>
    <div data-region="test-email-results" role="status" aria-live="polite" aria-atomic="true"></div>
</div>
{{#js}}
require(['local_mailwhistle/test_email'], function(TestEmail) {
    TestEmail.init('local-mailwhistle-test-email-{{campaignid}}');
});
{{/js}}
