{{!
    @template local_mailwhistle/resources

    Template to display the resources selection form.

    Context variables required for this template:
    * form - The rendered resources form HTML.
    * hasfiles - True when uploaded images exist.
    * files - Array of {filename, url, usage} public pluginfile URLs and saved references.
    * hasdocuments - True when non-image files exist.
    * documents - Array of {filename, usage} for email attachments and saved references.

    Example context (json):
    {
        "form": "<form></form>",
        "hasfiles": true,
        "files": [{
            "filename": "logo.png",
            "url": "https://example.edu/pluginfile.php/1/local_mailwhistle/resources/0/logo.png",
            "usage": "Campaign: Spring newsletter"
        }],
        "hasdocuments": true,
        "documents": [{"filename": "handbook.pdf", "usage": "Campaign: Welcome"}]
    }
}}
<aside class="card mb-4" aria-labelledby="local-mailwhistle-resources-help">
    <div class="card-body">
        <h2 class="h5" id="local-mailwhistle-resources-help">{{#str}}resources_help_heading, local_mailwhistle{{/str}}</h2>
        <p>{{#str}}resources_help_intro, local_mailwhistle{{/str}}</p>
        <ul class="mb-3">
            <li class="mb-2">
                <strong>{{#str}}resources_help_images, local_mailwhistle{{/str}}</strong>
                {{#str}}resources_help_images_desc, local_mailwhistle{{/str}}
            </li>
            <li>
                <strong>{{#str}}resources_help_documents, local_mailwhistle{{/str}}</strong>
                {{#str}}resources_help_documents_desc, local_mailwhistle{{/str}}
            </li>
        </ul>
        <p class="small mb-0">{{#str}}resources_inuse_help, local_mailwhistle{{/str}}</p>
    </div>
</aside>
{{{form}}}
{{#hasfiles}}
<div class="local-mailwhistle-resource-urls mt-4">
    <h3>{{#str}}resources_publicurls, local_mailwhistle{{/str}}</h3>
    <p>{{#str}}resources_publicurls_desc, local_mailwhistle{{/str}}</p>
    <ul class="list-unstyled">
        {{#files}}
            <li class="local-mailwhistle-resource-url mb-3">
                <div class="mb-1">{{filename}}</div>
                {{#usage}}<p class="small text-muted mb-1">{{usage}}</p>{{/usage}}
                <img src="{{url}}" alt="{{filename}}" class="local-mailwhistle-resource-thumb d-block mb-1">
                <code class="d-block text-break">{{url}}</code>
            </li>
        {{/files}}
    </ul>
</div>
{{/hasfiles}}
{{#hasdocuments}}
<div class="local-mailwhistle-resource-attachments mt-4">
    <h3>{{#str}}resources_attachments, local_mailwhistle{{/str}}</h3>
    <p>{{#str}}resources_attachments_desc, local_mailwhistle{{/str}}</p>
    <ul>
        {{#documents}}
            <li>
                {{filename}}
                {{#usage}}<p class="small text-muted mb-1">{{usage}}</p>{{/usage}}
            </li>
        {{/documents}}
    </ul>
</div>
{{/hasdocuments}}
