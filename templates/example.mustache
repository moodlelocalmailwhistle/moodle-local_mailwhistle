{{! Local plugin "Mail Whistle" - Example template.
 ! 
 ! @package   local_mailwhistle
 ! @copyright 2024 Your Name/Organization
 ! @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
 !
 ! TEMPLATE CONVENTIONS:
 ! - All custom CSS classes prefixed with .local-mailwhistle-* to prevent conflicts
 ! - Semantic HTML with proper heading hierarchy
 ! - ARIA attributes for accessibility and screen reader support
 ! - Conditional rendering for empty/missing data blocks
 ! - BEM (Block Element Modifier) naming convention for classes
 !
 ! REQUIRED CONTEXT VARIABLES:
 ! - title: String - Card heading/title
 ! - description: String - Main content description text
 ! - items: Array - List of item objects with {name, value} properties
 ! - buttonlabel: String - Label text for the action button
 }}

<div class="local-mailwhistle-example" role="region" aria-label="{{title}}">
    <article class="card">
        {{! Card Header Section !}}
        <header class="card-header">
            <h2 class="card-title">{{title}}</h2>
        </header>

        {{! Card Body Section with Main Content !}}
        <section class="card-body" role="main">
            {{! Main description text !}}
            <p class="card-description">{{description}}</p>

            {{! Items list - conditionally rendered if items exist !}}
            {{#items}}
                <ul class="items-list" aria-label="Item details">
                    {{#items}}
                        <li class="item" role="listitem">
                            <span class="item-label"><strong>{{name}}:</strong></span>
                            <span class="item-value">{{value}}</span>
                        </li>
                    {{/items}}
                </ul>
            {{/items}}

            {{! Fallback message if no items provided !}}
            {{^items}}
                <p class="no-items-message" aria-live="polite">No items to display.</p>
            {{/items}}
        </section>

        {{! Card Footer Section with Actions !}}
        <footer class="card-footer">
            <button class="btn btn-primary" id="example-btn" aria-label="{{buttonlabel}}">
                {{buttonlabel}}
            </button>
        </footer>
    </article>
</div>
