{{!
    @template local_mailwhistle/template_preview

    Full-page template preview.

    Context variables required for this template:
    * name - format_string() template name.
    * listurl, canmanage, editurl, exporturl
    * id, actionurl, sesskey - POST action for duplicating the template.
    * haspreviewtext, previewtext
    * hasbody, bodyhtml - bodyhtml is sanitised by format_text().
    * background - Safe hex colour.

    Example context (json):
    {
        "name": "Default",
        "listurl": "#",
        "canmanage": true,
        "editurl": "#",
        "exporturl": "#",
        "id": 1,
        "actionurl": "/local/mailwhistle/index.php",
        "sesskey": "abc",
        "haspreviewtext": false,
        "previewtext": "",
        "hasbody": true,
        "bodyhtml": "<p>Hi</p>",
        "background": "#ffffff"
    }
}}
<div class="local-mailwhistle-template-fullpreview">
    <div class="local-mailwhistle-preview-toolbar">
        <a href="{{listurl}}" class="btn btn-secondary me-1">
            {{#pix}}i/return, core{{/pix}} {{#str}}backtotemplates, local_mailwhistle{{/str}}
        </a>
        {{#canmanage}}
            <a href="{{editurl}}" class="btn btn-primary me-1">
                {{#pix}}t/edit, core{{/pix}} {{#str}}template_edit, local_mailwhistle{{/str}}
            </a>
            <form method="post" action="{{actionurl}}" class="d-inline-block m-0 me-1">
                <input type="hidden" name="tab" value="templates">
                <input type="hidden" name="action" value="duplicate">
                <input type="hidden" name="id" value="{{id}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-secondary">
                    {{#pix}}t/copy, core{{/pix}} {{#str}}template_duplicate, local_mailwhistle{{/str}}
                </button>
            </form>
            <a href="{{exporturl}}" class="btn btn-secondary">
                {{#pix}}t/download, core{{/pix}} {{#str}}template_export, local_mailwhistle{{/str}}
            </a>
        {{/canmanage}}
    </div>
    <h3>{{{name}}}</h3>
    {{#haspreviewtext}}
        <div class="local-mailwhistle-template-previewtext">
            <span class="local-mailwhistle-template-label">{{#str}}template_previewtext_label, local_mailwhistle{{/str}}</span>
            {{{previewtext}}}
        </div>
    {{/haspreviewtext}}
    <div class="local-mailwhistle-email-preview" style="background: {{background}};">
        {{#hasbody}}{{{bodyhtml}}}{{/hasbody}}
        {{^hasbody}}
            <div class="local-mailwhistle-template-preview-empty">{{#str}}template_no_body, local_mailwhistle{{/str}}</div>
        {{/hasbody}}
    </div>
</div>
