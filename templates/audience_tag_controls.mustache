{{!
    @template local_mailwhistle/audience_tag_controls

    Tag assignment controls inside the audience selection POST form.

    Context variables required for this template:
    * hastags - Whether any existing tags can be selected.
    * tags - Existing tags with id and name fields.
    * counttemplate - Localized selected count text retaining the {$a} placeholder.

    Example context (json):
    {
        "hastags": true,
        "tags": [{"id": 1, "name": "Newsletter"}],
        "counttemplate": "Selected people: {$a}"
    }
}}
<section id="local-mailwhistle-tag-controls" class="card mt-4" aria-labelledby="local-mailwhistle-tag-heading">
    <div class="card-body">
        <h4 id="local-mailwhistle-tag-heading">{{#str}}audience_addtag, local_mailwhistle{{/str}}</h4>
        <p class="text-muted mb-3">{{#str}}audience_taghint, local_mailwhistle{{/str}}</p>
        <p class="local-mailwhistle-selection-count mb-3" data-region="selection-count" role="status" aria-live="polite" hidden
           data-count-template="{{counttemplate}}">
            {{#str}}audience_noselected, local_mailwhistle{{/str}}
        </p>
        <fieldset class="border-0 p-0 m-0" aria-labelledby="local-mailwhistle-tag-heading">
            <div class="local-mailwhistle-tag-modes mb-3">
                {{#hastags}}
                    <div class="form-check">
                        <input type="radio" class="form-check-input" id="local-mailwhistle-tag-existing"
                               name="tagmode" value="existing" checked>
                        <label class="form-check-label" for="local-mailwhistle-tag-existing">
                            {{#str}}audience_existingtag, local_mailwhistle{{/str}}
                        </label>
                    </div>
                {{/hastags}}
                <div class="form-check">
                    <input type="radio" class="form-check-input" id="local-mailwhistle-tag-new"
                           name="tagmode" value="new" {{^hastags}}checked{{/hastags}}>
                    <label class="form-check-label" for="local-mailwhistle-tag-new">
                        {{#str}}audience_newtag, local_mailwhistle{{/str}}
                    </label>
                </div>
            </div>
            <div class="local-mailwhistle-tag-fields">
                {{#hastags}}
                    <div data-region="existing-tag" class="mb-3">
                        <label for="local-mailwhistle-applytagid">{{#str}}apply_tag_choose, local_mailwhistle{{/str}}</label>
                        <select class="form-control form-select" id="local-mailwhistle-applytagid" name="applytagid">
                            <option value="0">{{#str}}apply_tag_choose, local_mailwhistle{{/str}}</option>
                            {{#tags}}
                                <option value="{{id}}">{{name}}</option>
                            {{/tags}}
                        </select>
                    </div>
                {{/hastags}}
                <div data-region="new-tag" class="mb-3">
                    <label for="local-mailwhistle-newtagname">{{#str}}new_tag, local_mailwhistle{{/str}}</label>
                    <input type="text" class="form-control" id="local-mailwhistle-newtagname" name="newtagname"
                           maxlength="255" placeholder="{{#str}}audience_tagexample, local_mailwhistle{{/str}}">
                </div>
            </div>
        </fieldset>
        <button type="submit" class="btn btn-primary local-mailwhistle-tag-apply" data-action="apply-tag">
            {{#str}}audience_addtagbutton, local_mailwhistle{{/str}}
        </button>
    </div>
</section>
{{#js}}
require(['local_mailwhistle/audience'], function(Audience) {
    Audience.init('local-mailwhistle-tag-controls');
});
{{/js}}
