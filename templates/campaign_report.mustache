{{!
    @template local_mailwhistle/campaign_report

    Campaign report: email preview, stats cards and recipient roster.

    Context variables required for this template:
    * listurl - Back-to-list URL.
    * notfound - True when the campaign is missing or not reportable.
    * campaignname - Formatted campaign name.
    * statushtml - Rendered status badge.
    * stats - Array of {label, value, detail, note}.
    * metarows - Array of {label, value} where value is already escaped/HTML.
    * table - Rendered recipient table HTML.
    * deliverystatus - Optional delivery_status partial context for sending campaigns.
    * retrybutton - Optional POST button for retrying known failures.
    * previewunavailable - True when a requested recipient cannot be previewed.
    * emailpreview - Subject, recipientlabel, hasrecipient, previewhtml, hasbody,
      bodytext, hasplaintext, attachments and hasattachments for the saved campaign.

    Example context (json):
    {
        "listurl": "/local/mailwhistle/index.php?tab=reports",
        "notfound": false,
        "campaignname": "Spring newsletter",
        "statushtml": "<span>Sent</span>",
        "stats": [{"label": "Recipients", "value": "12", "detail": ""}],
        "metarows": [{"label": "Audience", "value": "Staff"}],
        "table": "<table></table>",
        "retrybutton": "<form method=\"post\"><button type=\"submit\">Retry failed recipients</button></form>",
        "previewunavailable": false,
        "emailpreview": {
            "subject": "Spring news",
            "recipientlabel": "Alice Rowe <alice@example.com>",
            "hasrecipient": true,
            "previewhtml": "<!doctype html><html><body><p>Hello Alice</p></body></html>",
            "hasbody": true,
            "bodytext": "Hello Alice",
            "hasplaintext": true,
            "attachments": [{"filename": "handbook.pdf"}],
            "hasattachments": true
        }
    }
}}
<div class="local-mailwhistle-campaign-report">
    <div class="local-mailwhistle-back mb-3">
        <a href="{{listurl}}" class="btn btn-secondary">{{#str}}report_back, local_mailwhistle{{/str}}</a>
    </div>
    {{#notfound}}
        <div class="alert alert-warning">{{#str}}mailnotfound, local_mailwhistle{{/str}}</div>
    {{/notfound}}
    {{^notfound}}
        <div class="local-mailwhistle-report-heading">
            <h2 class="h3 mb-0">{{{campaignname}}}</h2>
            <div>{{{statushtml}}}</div>
        </div>
        {{#deliverystatus}}
            {{> local_mailwhistle/delivery_status}}
        {{/deliverystatus}}
        {{#retrybutton}}
            <div class="mb-3">
                <p>{{#str}}retryfailed_help, local_mailwhistle{{/str}}</p>
                {{{retrybutton}}}
            </div>
        {{/retrybutton}}
        <div class="local-mailwhistle-report-stats">
            {{#stats}}
                <div class="local-mailwhistle-report-stat card">
                    <div class="card-body">
                        <div class="local-mailwhistle-report-stat-value">{{value}}</div>
                        <div class="local-mailwhistle-report-stat-label">{{label}}</div>
                        {{#detail}}
                            <div class="local-mailwhistle-report-stat-detail">{{detail}}</div>
                        {{/detail}}
                        {{#note}}<div class="local-mailwhistle-report-stat-detail">{{note}}</div>{{/note}}
                    </div>
                </div>
            {{/stats}}
        </div>
        <p class="small text-muted">{{#str}}reports_help_engagement_desc, local_mailwhistle{{/str}}</p>
        <div class="local-mailwhistle-report-layout mb-4">
            <section class="card local-mailwhistle-report-message" id="local-mailwhistle-report-email"
                     aria-labelledby="local-mailwhistle-report-email-heading">
                <div class="card-header">
                    <h3 class="h5 mb-0" id="local-mailwhistle-report-email-heading">
                        {{#str}}report_emailpreview, local_mailwhistle{{/str}}
                    </h3>
                </div>
                {{#previewunavailable}}
                    <div class="card-body">
                        <p class="mb-0">{{#str}}report_previewunavailable, local_mailwhistle{{/str}}</p>
                    </div>
                {{/previewunavailable}}
                {{#emailpreview}}
                    <div class="card-body local-mailwhistle-report-envelope">
                        <div class="text-muted mb-1">{{#str}}subject, local_mailwhistle{{/str}}</div>
                        <h4 class="h5 mb-2">{{subject}}</h4>
                        {{#hasrecipient}}
                            <p class="mb-0"><strong>{{#str}}report_previewrecipient, local_mailwhistle{{/str}}:</strong>
                                {{recipientlabel}}</p>
                        {{/hasrecipient}}
                        {{^hasrecipient}}
                            <p class="mb-0">{{#str}}report_previewgeneric, local_mailwhistle{{/str}}</p>
                        {{/hasrecipient}}
                    </div>
                    {{#hasbody}}
                        <iframe id="local-mailwhistle-report-email-frame" class="local-mailwhistle-report-email-frame"
                                sandbox="" referrerpolicy="no-referrer"
                                title="{{#str}}report_emailpreview, local_mailwhistle{{/str}}" srcdoc="{{previewhtml}}"></iframe>
                    {{/hasbody}}
                    {{^hasbody}}
                        <p class="p-3 mb-0">{{#str}}report_previewempty, local_mailwhistle{{/str}}</p>
                    {{/hasbody}}
                    <div class="card-body">
                        {{#hasattachments}}
                            <div class="mb-3">
                                <h4 class="h6">{{#str}}report_attachments, local_mailwhistle{{/str}}</h4>
                                <ul class="local-mailwhistle-report-attachments list-unstyled mb-0">
                                    {{#attachments}}<li class="border rounded px-2 py-1">{{filename}}</li>{{/attachments}}
                                </ul>
                            </div>
                        {{/hasattachments}}
                        {{#hasplaintext}}
                            <details class="local-mailwhistle-report-plaintext mb-3">
                                <summary>{{#str}}report_plaintext, local_mailwhistle{{/str}}</summary>
                                <pre class="mt-2 mb-0">{{bodytext}}</pre>
                            </details>
                        {{/hasplaintext}}
                        <p class="small text-muted mb-0">{{#str}}report_previewhint, local_mailwhistle{{/str}}</p>
                    </div>
                {{/emailpreview}}
            </section>
            <aside class="card align-self-start" aria-labelledby="local-mailwhistle-report-details-heading">
                <div class="card-body">
                    <h3 class="h5 mb-3" id="local-mailwhistle-report-details-heading">
                        {{#str}}report_details, local_mailwhistle{{/str}}
                    </h3>
                    <dl class="local-mailwhistle-report-meta mb-0">
                        {{#metarows}}
                            <div>
                                <dt>{{label}}</dt>
                                <dd>{{{value}}}</dd>
                            </div>
                        {{/metarows}}
                    </dl>
                </div>
            </aside>
        </div>
        <section aria-labelledby="local-mailwhistle-report-recipients-heading">
            <h3 class="h4" id="local-mailwhistle-report-recipients-heading">
                {{#str}}report_recipients, local_mailwhistle{{/str}}
            </h3>
            <div class="table-responsive">{{{table}}}</div>
        </section>
    {{/notfound}}
</div>
