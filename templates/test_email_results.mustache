{{!
    @template local_mailwhistle/test_email_results

    Plain-text outcomes for each requested test-email address.

    Context variables required for this template:
    * results - List of address, destination, diverted and message values.

    Example context (json):
    {
        "results": [
            {"address": "reviewer@example.com", "message": "Accepted by the email transport."},
            {"address": "missing@example.invalid", "message": "Not sent: invalid destination."},
            {
                "address": "another@example.com",
                "destination": "catcher@example.com",
                "diverted": true,
                "message": "Acceptance could not be confirmed. This copy may have been sent."
            }
        ]
    }
}}
<div class="mt-3">
    <p class="fw-bold">{{#str}} testmail_results, local_mailwhistle {{/str}}</p>
    <ul>
        {{#results}}
        <li>
            <strong>{{address}}</strong>: {{message}}
            {{#diverted}}<br>{{#str}} testmail_diverted, local_mailwhistle, {{destination}} {{/str}}{{/diverted}}
        </li>
        {{/results}}
    </ul>
</div>
