{{!
    @template local_mailwhistle/campaign_preview

    Sent-campaign detail preview.

    Context variables required for this template:
    * listurl - Back-to-list URL.
    * notfound - True when the campaign is missing or not sent.
    * subject - format_string() subject.
    * metarows - Array of {label, value} where value is already escaped/HTML.
    * bodyhtml - Sanitised campaign HTML from format_text().

    Example context (json):
    {
        "listurl": "/local/mailwhistle/index.php?tab=send",
        "notfound": false,
        "subject": "News",
        "metarows": [{"label": "Audience", "value": "Staff"}],
        "bodyhtml": "<p>Hello</p>"
    }
}}
<div class="local-mailwhistle-back mb-3">
    <a href="{{listurl}}">{{#str}}backtolist, local_mailwhistle{{/str}}</a>
</div>
{{#notfound}}
    <div class="alert alert-warning">{{#str}}mailnotfound, local_mailwhistle{{/str}}</div>
{{/notfound}}
{{^notfound}}
    <h3>{{{subject}}}</h3>
    <table class="table generaltable w-auto local-mailwhistle-mailmeta mb-3">
        <tbody>
            {{#metarows}}
                <tr>
                    <td>{{label}}</td>
                    <td>{{{value}}}</td>
                </tr>
            {{/metarows}}
        </tbody>
    </table>
    <h4>{{#str}}mailpreview, local_mailwhistle{{/str}}</h4>
    <div class="local-mailwhistle-mailbody card card-body">{{{bodyhtml}}}</div>
{{/notfound}}
