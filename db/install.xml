<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/mailwhistle/db" VERSION="20260630" COMMENT="Mail Whistle plugin database structure for Moodle 5.0+">
  <TABLES>
    <!-- Example: Simple data table for storing plugin records
         
         FIELD CONVENTIONS:
         - id: AUTO_INCREMENT primary key (always first field)
         - userid: Foreign key to mdl_user table (audits who created/owns record)
         - title: Short identifier/label for the record
         - description: Extended content field (use TEXT for variable length)
         - status: State machine field - helps with soft deletes and filtering
         - created: Unix timestamp of record creation
         - modified: Unix timestamp of last modification
         
         PERFORMANCE NOTES:
         - Indexes placed on frequently filtered columns (userid, status, creation)
         - Foreign key constraint maintains data integrity
         - TEXT field used efficiently (not bloat, just flexible)
    -->
    <TABLE NAME="local_mailwhistle_data" COMMENT="Data records for Mail Whistle plugin - stores user-generated content with audit trails">
      <FIELDS>
        <!-- Primary Key -->
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Auto-incrementing primary key"/>

        <!-- Foreign Keys and Ownership -->
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User ID - references mdl_user.id for record ownership"/>

        <!-- Content Fields -->
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Record title/name - searchable identifier"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Extended description/content - supports rich text"/>

        <!-- State Management -->
        <FIELD NAME="status" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="active" SEQUENCE="false" COMMENT="Record status: active|inactive|archived|deleted (enables soft deletes)"/>

        <!-- Timestamps for Auditing -->
        <FIELD NAME="created" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp - when record was created"/>
        <FIELD NAME="modified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Unix timestamp - when record was last modified"/>
      </FIELDS>

      <!-- Key Constraints -->
      <KEYS>
        <!-- Primary Key - ensures unique identity -->
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        
        <!-- Foreign Key - links to user table with cascade behavior
             RESTRICT: Prevents deletion of user if record exists (safer for data integrity)
             Uncomment ondelete attribute to customize cascade behavior:
             ondelete="RESTRICT|CASCADE|SET NULL"
        -->
        <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>

      <!-- Performance Indexes -->
      <!-- INDEX STRATEGY:
           - Created on columns frequently used in WHERE clauses
           - Improves query performance for filtering operations
           - Consider table size and query patterns when adding/removing indexes
      -->
      <INDEXES>
        <!-- Index for user-based queries (common: "show my records") -->
        <INDEX NAME="userid_idx" UNIQUE="false" FIELDS="userid"/>

        <!-- Index for status-based filtering (common: "show active records") -->
        <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>

        <!-- Composite index for user+status (optimizes common combined queries) -->
        <INDEX NAME="userid_status_idx" UNIQUE="false" FIELDS="userid,status"/>

        <!-- Index for date-based queries and sorting -->
        <INDEX NAME="created_idx" UNIQUE="false" FIELDS="created"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_mailwhistle_tag" COMMENT="Tag definitions for Mail Whistle audience segmentation">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Auto-incrementing primary key"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Display name of the tag (trimmed)"/>
        <FIELD NAME="shortname" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Normalized key (strtolower), unique, used for deduplication"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Optional notes about the tag"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User who created or last modified the tag"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Unix timestamp of tag creation"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Unix timestamp of last tag modification"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="usermodified_fk" TYPE="foreign" FIELDS="usermodified" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="shortname_uix" UNIQUE="true" FIELDS="shortname" COMMENT="Enforces case-insensitive uniqueness on normalized shortname"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_mailwhistle_tag_assign" COMMENT="Many-to-many user-to-tag assignments for Mail Whistle audience segmentation">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Auto-incrementing primary key"/>
        <FIELD NAME="tagid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="FK to local_mailwhistle_tag.id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="FK to user.id (the tagged user)"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User who created the assignment"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Unix timestamp of assignment creation"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="tagid_fk" TYPE="foreign" FIELDS="tagid" REFTABLE="local_mailwhistle_tag" REFFIELDS="id"/>
        <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="tagid_userid_uix" UNIQUE="true" FIELDS="tagid,userid" COMMENT="Prevents duplicate assignments; allows idempotent bulk re-apply"/>
        <INDEX NAME="userid_ix" UNIQUE="false" FIELDS="userid" COMMENT="Supports per-user privacy export/delete and per-page tag fetch"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
